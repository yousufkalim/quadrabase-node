<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pdf Document</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@4.5.3/dist/css/bootstrap.min.css"
      integrity="sha384-TX8t27EcRE3e/ihU7zmQxVncDAy5uIKz4rEkgIXeMed4M0jlfIDPvg6uqKI2xXr2"
      crossorigin="anonymous"
    />
  </head>
  <body style="font-size: 12px">
    <style>
      .header_text {
        font-size: {{this.sizes.f14}};
        font-weight: 600;
        padding: 0 20px;
        border: 1px solid black;
        width: {{this.sizes.3s.text}}
      }

      .header_center_text {
        font-size: {{this.sizes.f14}};
        font-weight: 600;
        padding: 0 20px;
        border: 1px solid black;
        width: {{this.sizes.3s.text_main}}
      }

      .body_header_text {
        font-size: {{this.sizes.f14}};
        font-weight: 500;
        border: 1px solid black;
        width: {{this.sizes.6s.text}}
      }

      .body_header_name_text {
        font-size: {{this.sizes.f14}};
        font-weight: 500;
        border: 1px solid black;
        width: {{this.sizes.6s.text_main}}
      }

      .body_text {
        font-size: {{this.sizes.f12}};
        font-weight: normal;
        border: 1px solid black;
        width: {{this.sizes.6s.text}}
      }

      .body_name_text {
        font-size: {{this.sizes.f12}};
        font-weight: normal;
        border: 1px solid black;
        width: {{this.sizes.6s.text_main}}
      }

      .footer_key_text {
        font-size: {{this.sizes.f12}};
        font-weight: bold;
        border: 1px solid black;
        width: {{this.sizes.3s.text}}
      }

      .footer_value_text {
        font-size: {{this.sizes.f12}};
        font-weight: normal;
        border: 1px solid black;
        width: {{this.sizes.3s.text}}
      }

      .footer_table {
        margin-left: {{this.sizes.tt_table_margin}};
      }
    </style>
    <table style="margin-bottom: 20px;">
      <tr>
        <td align="left" valign="top">
          <tr style="background-color: #c0c0c0; padding: 10px 20px">
            {{#each this.headerArr}}
            <td align="center" class={{#ifCond this.i '!=' 1}} header_text {{/ifCond}} {{#ifCond this.i '==' 1}} header_center_text {{/ifCond}}><strong>{{this.v}}</strong></td>
            {{/each}}
          </tr>
        </td>
      </tr>
    <table>
    <table style="margin-bottom: 20px;">
      <tr>
        <td align="left" valign="top">
          <tr style="background-color: #c0c0c0;">
            {{#each this.bodyKeysArr}}
            <td {{#ifCond this.i '!=' 0}}{{#ifCond this.i '!=' 1}}align= "center"{{/ifCond}}{{/ifCond}}class={{#ifCond this.i '!=' 1}} body_header_text {{/ifCond}} {{#ifCond this.i '==' 1}} body_header_name_text {{/ifCond}}><strong>{{this.v}}</strong></td>
            {{/each}}
          </tr>
        </td>
        {{#each this.bodyValuesArr}}
          <td align="left" valign="top">
            <tr style="background-color: #FFFFFF;">
              {{#each this.v.data as |child childIndex|}}
              <td align={{#ifCond ../this.v.type '==' 'total'}}right{{/ifCond}}   {{#ifCond ../this.v.type '!=' 'total'}} {{#ifCond childIndex '!=' 0}}{{#ifCond childIndex '!=' 1}} {{#ifCond childIndex '!=' 2}} right {{/ifCond}}{{/ifCond}}{{/ifCond}} {{#ifCond childIndex '==' 1}} left {{/ifCond}}{{#ifCond childIndex '==' 0}} left {{/ifCond}}{{#ifCond childIndex '==' 2}} center {{/ifCond}}{{/ifCond}} class={{#ifCond childIndex '!=' 1}} body_text {{/ifCond}} {{#ifCond childIndex '==' 1}} body_name_text {{/ifCond}}> {{#ifCond ../this.v.type '==' 'title'}}<strong> {{this}}</strong> {{/ifCond}} {{#ifCond ../this.v.type '==' 'total'}}<strong> {{this}}</strong>{{/ifCond}} {{#ifCond ../this.v.type '!=' 'total'}}{{#ifCond ../this.v.type '!=' 'title'}} {{this}} {{/ifCond}}{{/ifCond}}  </td>
              {{/each}}
            </tr>
          </td>
        {{/each}}
      </tr>
    <table>
    <table class="footer_table">
      <tr>
        {{#each this.footerArr}}
          <td align="left" valign="top">
            <tr style="background-color: #FFFFFF;">
              {{#each this}}
              <td align="right" class={{#ifCond this.i '==' 0}} footer_key_text {{/ifCond}} {{#ifCond this.i '==' 1}} footer_value_text {{/ifCond}}><strong>{{this.v}}</strong></td>
              {{/each}}
            </tr>
          </td>
        {{/each}}
      </tr>
    <table>
  </body>
</html>